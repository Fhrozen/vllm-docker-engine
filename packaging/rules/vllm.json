{
  "schema_version": 2,
  "id": "vllm-slim",
  "name": "vllm",
  "version": "auto",
  "platform": "linux-x86_64",
  "backend": "cuda",
  "entrypoint": "vllm serve",
  "python": "3.12",
  "requirements": {
    "clone": "vllm",
    "files": ["requirements/common.txt", "requirements/cuda.txt"],
    "names": [
      "aiohttp", "anthropic", "apache-tvm-ffi", "blake3", "cachetools",
      "cbor2", "cloudpickle", "compressed-tensors", "depyf", "einops",
      "fastapi", "fastsafetensors", "filelock", "flashinfer-python",
      "huggingface-hub", "humming-kernels", "ijson", "instanttensor",
      "jsonschema", "lark", "llguidance", "lm-format-enforcer", "mcp",
      "mistral-common", "model-hosting-container-standards", "msgspec",
      "ninja", "numba", "numpy", "nvidia-cudnn-frontend",
      "nvidia-cutlass-dsl", "nvtx", "openai", "opencv-python-headless",
      "opentelemetry-api", "opentelemetry-exporter-otlp",
      "opentelemetry-sdk", "opentelemetry-semantic-conventions-ai",
      "oss-harmony", "outlines-core", "partial-json-parser", "pillow",
      "prometheus-client", "prometheus-fastapi-instrumentator", "protobuf",
      "psutil", "py-cpuinfo", "pybase64", "pydantic", "pynvvideocodec",
      "python-json-logger", "pyyaml", "pyzmq", "quack-kernels", "regex",
      "requests", "safetensors", "sentencepiece", "setproctitle",
      "setuptools", "six", "starlette", "tiktoken", "tilelang",
      "tokenizers", "tokenspeed-mla", "torch", "torchaudio", "torchcodec",
      "torchvision", "tqdm", "transformers", "typing-extensions",
      "watchfiles", "xgrammar"
    ]
  },
  "allow": ["**"],
  "deny": [
    "torchcodec",
    "pynvvideocodec",
    "pip",
    "wheel",
    "pkgconfig",
    "pre-commit",
    "ruff",
    "mypy",
    "pytest",
    "pytest-asyncio",
    "build",
    "ninja",
    "cmake",
    "pybind11",
    "datasets",
    "soundfile",
    "xformers",
    "flashinfer-cubin",
    "cupy-cuda12x"
  ],
  "prune": [
    "**/tests/**",
    "**/test/**",
    "**/*.a",
    "**/*.o",
    "**/*.cmake",
    "**/pkgconfig/**",
    "**/include/**",
    "**/docs/**",
    "**/doc/**",
    "**/examples/**",
    "nvidia/*/bin/**",
    "nvidia/nvvm/**",
    "nvidia/*/nsight/**",
    "**/*.pyi",
    "**/*.pyx",
    "**/*.th",
    "**/*.map",
    "**/*.ipynb",
    "**/test-data/**",
    "**/testdata/**",
    "numba/np/ufunc/tbbpool*",
    "nvidia/nvshmem/lib/*.bc",
    "nvidia/nvshmem/lib/nvshmem_bootstrap_mpi.so*",
    "nvidia/nvshmem/lib/nvshmem_bootstrap_pmix.so*",
    "nvidia/nvshmem/lib/nvshmem_bootstrap_shmem.so*",
    "nvidia/nvshmem/lib/nvshmem_transport_libfabric.so*",
    "nvidia/nvshmem/lib/nvshmem_transport_ucx.so*",
    "nvidia/nvshmem/lib/nvshmem_transport_ibgda.so*",
    "nvidia/nvshmem/lib/nvshmem_transport_ibdevx.so*",
    "nvidia/cufile/lib/libcufile_rdma.so*"
  ],
  "bytecode": "pyc-only",
  "strip": true,
  "arch_filter": "auto",
  "cuda_variant": "nvidia_cutlass_dsl",
  "system_libs": [
    "libcudart.so.12",
    "libcublas.so.12",
    "libcublasLt.so.12",
    "libcurand.so.10",
    "libcusparse.so.12",
    "libnccl.so.2",
    "libnvrtc.so.12",
    "libnvtx-priv.so.3",
    "libtriton.so"
  ],
  "driver_libs": [
    "libcuda.so.1",
    "libnvidia-ml.so.1",
    "libnvidia-ptxjitcompiler.so.1",
    "libnvidia-encode.so.1",
    "libnvidia-nvvm.so.4"
  ],
  "runtime_apt": [
    "tini",
    "ca-certificates",
    "libgomp1",
    "libatomic1",
    "libnuma1",
    "zlib1g",
    "libstdc++6",
    "numactl"
  ],
  "forbidden_tools": [
    "cc",
    "gcc",
    "g++",
    "clang",
    "cmake",
    "ninja",
    "nvcc",
    "ld",
    "strip",
    "pip",
    "pip3",
    "uv",
    "git",
    "curl",
    "wget"
  ]
}
