{
  "schema_version": 2,
  "id": "vllm-slim",
  "name": "vllm",
  "version": "auto",
  "platform": "linux-x86_64",
  "backend": "cuda",
  "entrypoint": "vllm serve",
  "python": "3.12",
  "requirements": {
    "clone": "vllm",
    "files": ["requirements/common.txt", "requirements/cuda.txt"]
  },
  "allow": ["**"],
  "deny": [
    "torchvision",
    "torchaudio",
    "torchcodec",
    "pynvvideocodec",
    "pip",
    "setuptools",
    "wheel",
    "pkgconfig",
    "pre-commit",
    "ruff",
    "mypy",
    "pytest",
    "pytest-asyncio",
    "build",
    "ninja",
    "cmake",
    "pybind11",
    "datasets",
    "huggingface-hub",
    "soundfile",
    "sentencepiece",
    "xformers",
    "flashinfer-python"
  ],
  "prune": [
    "**/tests/**",
    "**/test/**",
    "**/*.a",
    "**/*.o",
    "**/*.cmake",
    "**/pkgconfig/**",
    "**/include/**",
    "**/docs/**",
    "**/doc/**",
    "**/examples/**",
    "**/benchmarks/**",
    "nvidia/*/bin/**",
    "nvidia/cupti/**",
    "nvidia/cusparseLt/**",
    "nvidia/nvvm/**",
    "nvidia/*/nsight/**",
    "**/*.pyi",
    "**/*.pyx",
    "**/*.th",
    "**/*.map",
    "**/*.ipynb",
    "**/test-data/**",
    "**/testdata/**"
  ],
  "bytecode": "pyc-only",
  "strip": true,
  "arch_filter": "auto",
  "system_libs": [
    "libcudart.so.12",
    "libcublas.so.12",
    "libcublasLt.so.12",
    "libcurand.so.10",
    "libcusparse.so.12",
    "libnccl.so.2",
    "libnvrtc.so.12",
    "libnvtx-priv.so.3",
    "libtriton.so"
  ],
  "driver_libs": [
    "libcuda.so.1",
    "libnvidia-ml.so.1",
    "libnvidia-ptxjitcompiler.so.1",
    "libnvidia-encode.so.1",
    "libnvidia-nvvm.so.4"
  ],
  "runtime_apt": [
    "tini",
    "ca-certificates",
    "libgomp1",
    "libatomic1",
    "libnuma1",
    "zlib1g",
    "libstdc++6",
    "numactl"
  ],
  "forbidden_tools": [
    "cc",
    "gcc",
    "g++",
    "clang",
    "cmake",
    "ninja",
    "nvcc",
    "ld",
    "strip",
    "pip",
    "pip3",
    "uv",
    "git",
    "curl",
    "wget"
  ]
}
