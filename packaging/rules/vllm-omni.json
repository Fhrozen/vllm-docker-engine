{
  "schema_version": 2,
  "id": "vllm-omni-slim",
  "name": "vllm-omni",
  "version": "auto",
  "platform": "linux-x86_64",
  "backend": "cuda",
  "entrypoint": "vllm-omni serve",
  "python": "3.12",
  "overlay_on": "vllm-slim",
  "requirements": {
    "clone": "vllm-omni",
    "files": ["requirements/common.txt", "requirements/cuda.txt"],
    "names": [
      "accelerate", "aenum", "av", "cache-dit", "cosmos-guardrail",
      "diffusers", "einops", "gguf", "imageio", "janus", "kernels",
      "msgpack", "omegaconf", "onnxruntime", "openai-whisper", "prettytable",
      "pydantic", "pydantic-settings", "pyzmq", "s3tokenizer", "safetensors",
      "scipy", "soundfile", "soxr", "torchsde", "tqdm", "transformers",
      "typing-extensions", "x-transformers"
    ]
  },
  "allow": ["vllm_omni/**", "*.dist-info/**"],
  "deny": [
    "pip",
    "setuptools",
    "wheel",
    "pre-commit",
    "ruff",
    "mypy",
    "pytest",
    "build",
    "ninja",
    "cmake"
  ],
  "prune": [
    "**/tests/**",
    "**/test/**",
    "**/docs/**",
    "**/doc/**",
    "**/examples/**",
    "**/benchmarks/**",
    "**/recipes/**",
    "**/scripts/**",
    "**/tools/**",
    "**/*.pyi",
    "**/*.pyx",
    "**/*.map",
    "**/*.ipynb",
    "**/test-data/**",
    "**/testdata/**"
  ],
  "bytecode": "source",
  "pyc_invalidation": "checked-hash",
  "strip": false,
  "arch_filter": "auto",
  "system_libs": [],
  "driver_libs": [
    "libcuda.so.1",
    "libnvidia-ml.so.1"
  ],
  "runtime_apt": [],
  "forbidden_tools": [
    "cc",
    "gcc",
    "g++",
    "cmake",
    "ninja",
    "nvcc",
    "ld",
    "pip",
    "uv",
    "git",
    "curl",
    "wget"
  ],
  "entry_points": {
    "vllm.general_plugins": "vllm_omni.engine.arg_utils:register_omni_models_to_vllm"
  }
}
